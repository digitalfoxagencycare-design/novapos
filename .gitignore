# Build output must never land in a source tree. A stale .js beside a .ts
# silently shadows it during bundling, which is a genuinely confusing failure.
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts.map
