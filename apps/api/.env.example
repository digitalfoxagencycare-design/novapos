# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/novapos?schema=public"

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
# Never commit a real value. The API refuses to boot with the placeholder.
JWT_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_48"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Comma-separated origins allowed to call the API and open a socket.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# ── Real-time ───────────────────────────────────────────────────────────────
# Optional. Without Redis the WebSocket gateway works within a single API
# process; with it, KOT pushes fan out across a horizontally scaled cluster.
REDIS_URL=""

# ── SMS / OTP Provider (Fast2SMS) ───────────────────────────────────────────
# Get API Key from https://www.fast2sms.com/dev/bulkV2
FAST2SMS_API_KEY=""

# ── Payments (per-tenant values live in the DB; these are platform defaults) ─
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Printing ────────────────────────────────────────────────────────────────
# Seconds a queued print job waits before the first retry; doubles each attempt.
PRINT_RETRY_BASE_SECONDS=5
PRINT_MAX_ATTEMPTS=6
