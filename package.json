{
  "name": "novapos",
  "version": "0.1.0",
  "private": true,
  "description": "NovaPOS \u2014 multi-tenant POS + KOT platform for restaurants and retail",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "build:apps": "pnpm --filter \"./apps/**\" build",
    "test": "vitest run",
    "dev:api": "pnpm --filter @novapos/api dev",
    "dev:pos": "pnpm --filter @novapos/pos dev",
    "dev:admin": "pnpm --filter @novapos/admin dev",
    "db:generate": "pnpm --filter @novapos/api db:generate",
    "db:migrate": "pnpm --filter @novapos/api db:migrate",
    "db:studio": "pnpm --filter @novapos/api db:studio",
    "db:seed": "pnpm --filter @novapos/api seed",
    "lint": "pnpm -r lint",
    "dev:kds": "echo \"The kitchen screen is served by the POS app at /kds.html \u2014 run pnpm dev:pos\""
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.2"
  },
  "packageManager": "pnpm@10.28.0"
}
