{
  "name": "novapos",
  "version": "0.1.0",
  "private": true,
  "description": "NovaPOS — multi-tenant POS + KOT platform for restaurants and retail",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "build:apps": "pnpm --filter \"./apps/**\" build",
    "test": "vitest run",
    "dev:api": "pnpm --filter @novapos/api dev",
    "dev:pos": "pnpm --filter @novapos/pos dev",
    "dev:admin": "pnpm --filter @novapos/admin dev",
    "db:generate": "pnpm --filter @novapos/api db:generate",
    "db:migrate": "pnpm --filter @novapos/api db:migrate",
    "db:studio": "pnpm --filter @novapos/api db:studio",
    "db:seed": "pnpm --filter @novapos/api seed",
    "lint": "pnpm -r lint",
    "deploy:admin": "pnpm --filter @novapos/admin build && wrangler deploy --cwd apps/admin",
    "deploy:landing": "pnpm --filter @novapos/landing build && wrangler deploy --cwd apps/landing",
    "dev:kds": "echo \"The kitchen screen is served by the POS app at /kds.html — run pnpm dev:pos\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.143.0"
  },
  "packageManager": "pnpm@10.28.0"
}
